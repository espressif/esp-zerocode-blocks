# Flash size is NOT set here: the partition-table block owns it (8mb-voice
# carries FLASHSIZE_8MB, 16mb-voice carries FLASHSIZE_16MB) so the table and
# the flash size can never drift apart. The engine gates audio products onto
# a voice table, so the key always arrives.
CONFIG_SR_MN_EN_MULTINET7_QUANT="y"
CONFIG_SR_WN_WN9_HIESP="y"
CONFIG_MODEL_IN_FLASH="y"
CONFIG_SPIRAM="y"
# The PSRAM mode below is the S3 FLOOR for a board that declares none (a bare
# module): the S3 voice boards (Korvo, BOX) carry octal PSRAM. A board whose
# defaults name its own mode (an M5 CoreS3 is quad) loads after this file and
# wins. The three keys after CONFIG_SPIRAM are ESP32-S3 symbols; on the P4 and
# the S31 they do not exist and Kconfig ignores them.
CONFIG_SPIRAM_MODE_OCT="y"
CONFIG_SPIRAM_SPEED_80M="y"
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240="y"
# A board with no PSRAM, or with PSRAM in another mode than the one configured,
# must still boot: without this the 2nd-stage init aborts in cpu_start ("Failed
# to init external RAM!") and the board reset-loops. Voice then reports
# ESP_ERR_NO_MEM and is disabled (main_init logs it); the rest of the product
# runs. Same reasoning as frameworks/lm.
CONFIG_SPIRAM_IGNORE_NOTFOUND="y"
