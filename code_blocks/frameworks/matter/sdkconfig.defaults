# BLE — Matter commissions over BLE (on Wi-Fi, Thread and hosted builds alike).
CONFIG_BT_ENABLED="y"
CONFIG_BT_NIMBLE_ENABLED="y"
CONFIG_ESP_MATTER_ENABLE_DATA_MODEL="y"
CONFIG_ESP_MATTER_ENABLE_GENERATED_DATA_MODEL="y"
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_IPV6_AUTOCONFIG="y"
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT="y"
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT="y"
CONFIG_ENABLE_CHIP_SHELL="n"
CONFIG_ESP_ERR_TO_NAME_LOOKUP="n"
CONFIG_ESP_WIFI_SOFTAP_SUPPORT="n"
CONFIG_VFS_SUPPORT_DIR="n"
CONFIG_VFS_SUPPORT_TERMIOS="n"
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE="y"
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS="y"
CONFIG_CHIP_LOG_FILTERING="y"
CONFIG_CHIP_LOG_DEFAULT_LEVEL_NONE="y"
CONFIG_BOOTLOADER_LOG_LEVEL_WARN="y"
CONFIG_ESP_DEBUG_OCDAWARE="n"
# mbedTLS trim, pruned for IDF 6.2 / mbedTLS 4: TLS 1.0/1.1, static ECDH and
# the <256-bit curves were removed upstream, and HKDF is PSA-default-on —
# their old keys are unknown symbols now (kconfig warns, silently).
CONFIG_MBEDTLS_DYNAMIC_BUFFER="y"
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA="y"
CONFIG_MBEDTLS_TLS_CLIENT_ONLY="y"
CONFIG_MBEDTLS_ERROR_STRINGS="n"
CONFIG_MBEDTLS_HAVE_TIME="n"
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA="n"
CONFIG_MBEDTLS_SSL_RENEGOTIATION="n"
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS="n"
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS="n"
CONFIG_MBEDTLS_GCM_C="n"
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED="n"
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED="n"
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED="n"
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED="n"
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED="n"
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED="n"
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED="n"
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL="n"
CONFIG_BT_NIMBLE_ROLE_OBSERVER="n"
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_SECURITY_ENABLE="n"
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT="n"
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=100
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=5
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=5
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=3
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT="n"
CONFIG_BT_NIMBLE_LOG_LEVEL_ERROR="y"
CONFIG_BT_STACK_NO_LOG="y"
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING="y"
# Endpoint / device-type budgets, 8 each (Kconfig defaults are 16 endpoints and
# 2 device types). A device-type limit of 2 is too low for composite device
# types that stack several (solar_power pulls in electrical_sensor + power/energy
# management → >2): the endpoint's clusters fail to create and the device
# boot-fails, caught only by functional_testing. A single-endpoint product that
# wants the RAM back lowers these in its own extra_sdkconfig.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=8
CONFIG_ESP_MATTER_MAX_DEVICE_TYPE_COUNT=8
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER="n"
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER="n"
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER="n"
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER="n"
CONFIG_SUPPORT_CHANNEL_CLUSTER="n"
CONFIG_SUPPORT_CONTENT_LAUNCHER_CLUSTER="n"
CONFIG_SUPPORT_CONTENT_CONTROL_CLUSTER="n"
CONFIG_SUPPORT_CONTENT_APP_OBSERVER_CLUSTER="n"
CONFIG_SUPPORT_KEYPAD_INPUT_CLUSTER="n"
CONFIG_SUPPORT_LOW_POWER_CLUSTER="n"
CONFIG_SUPPORT_MEDIA_INPUT_CLUSTER="n"
CONFIG_SUPPORT_MEDIA_PLAYBACK_CLUSTER="n"
CONFIG_SUPPORT_TARGET_NAVIGATOR_CLUSTER="n"
CONFIG_SUPPORT_WAKE_ON_LAN_CLUSTER="n"
CONFIG_SUPPORT_COMMISSIONER_CONTROL_CLUSTER="n"
CONFIG_SUPPORT_DIAGNOSTIC_LOGS_CLUSTER="n"
CONFIG_SUPPORT_ECOSYSTEM_INFORMATION_CLUSTER="n"
CONFIG_SUPPORT_FAULT_INJECTION_CLUSTER="n"
CONFIG_SUPPORT_FIXED_LABEL_CLUSTER="n"
CONFIG_SUPPORT_USER_LABEL_CLUSTER="n"
CONFIG_SUPPORT_LOCALIZATION_CONFIGURATION_CLUSTER="n"
CONFIG_SUPPORT_TIME_FORMAT_LOCALIZATION_CLUSTER="n"
CONFIG_SUPPORT_UNIT_LOCALIZATION_CLUSTER="n"
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER="n"
CONFIG_SUPPORT_ICD_MANAGEMENT_CLUSTER="n"
CONFIG_SUPPORT_MESSAGES_CLUSTER="n"
CONFIG_SUPPORT_SAMPLE_MEI_CLUSTER="n"
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER="n"
